# Copy to .env — a HUMAN fills the real value; .env is git-ignored.
# Never place the key in browser code, logs, screenshots, chat, or committed files.
# A FIRMS MAP_KEY is NOT a generic api.nasa.gov key.
FIRMS_MAP_KEY=

# Backend reads exported environment variables; it does not auto-load .env.
# Loopback only by default. No FIRMS key needed for the server skeleton.
EMBERLINE_BIND_ADDR=127.0.0.1:8000
