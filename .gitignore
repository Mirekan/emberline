# Secrets — never commit. FIRMS MAP_KEY lives only in local .env (human-filled).
.env
.env.*
!.env.example
*.key
*.pem

# Rust (backend per cab7b61)
debug
target
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# Python — pipeline/ (B/C) stays Python; needed until that changes
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
web/dist/
web/.vite/

# Data caches — raw/processed bytes stay out of git; the MANIFEST is committed.
data/**
!data/raw/
data/raw/**
!data/raw/MANIFEST.json
# Small reviewable evidence under data/manifests/ is committed too (B-04/B-05):
# human-readable G1 evidence + the keyed availability probe backing DEC-1.
# fetch_ledger.jsonl and validation_report_*.json stay local (regenerated per run).
!data/manifests/
!data/manifests/*.md
!data/manifests/data_availability_*.csv

# Scientific artifacts — small versioned JSONs are committed; heavy binaries are not.
artifacts/**/*.parquet

# OS / editor noise
.DS_Store
*.swp

# tool artifacts
.agent/
